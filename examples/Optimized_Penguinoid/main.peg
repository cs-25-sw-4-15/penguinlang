tileset tileset_block_0 = "penguinoid_tileset.2bpp";
tileset tileset_block_2 = "penguinoid_tileset.2bpp";
tilemap tilemap0 = "penguinoid_tilemap.bin";

control_waitVBlankStart();
control_LCDoff();

display_tileset_block_0 = tileset_block_0;
display_tileset_block_2 = tileset_block_2;
display_tilemap0 = tilemap0;

int paddleX = 16;
int ballX = 25;
int ballY = 100;

int i = 0;
loop (i < 40) {
    display_oam_y[i] = 0;
    i = i + 1;
}

display_oam_tile[0] = 10;
display_oam_tile[1] = 11;

int Xtile = 0;
int Ytile = 0;
int Xmomentum = 1;
int Ymomentum = -1;
int tile = 0;
int left = 0;
int right = 0;

procedure handleBrickCollision() {
    if (tile == 5 or tile == 6) {
        display_tilemap0[Xtile][Ytile] = 8;
        Ymomentum = ~Ymomentum | 1;

        if (tile == 5) {
            display_tilemap0[Xtile+1][Ytile] = 8;
        } else {
            display_tilemap0[Xtile-1][Ytile] = 8;
        }
    }
}

procedure main() {
    int frame = 0;
    control_LCDon();
    control_initDisplayRegs();
    control_initPalette();

    loop (1) {
        control_waitVBlankOver();
        control_waitVBlankStart();

        if (frame == 0) {
            control_updateInput();
            left = control_checkLeft();
            right = control_checkRight();

            ballX = ballX + Xmomentum*2;
            ballY = ballY + Ymomentum*2;

            Xtile = (ballX-9) >> 3;
            Ytile = (ballY-16) >> 3;
            tile = display_tilemap0[Xtile][Ytile];

            handleBrickCollision();
            if (tile == 4 or tile == 7 or tile == 2 or tile == 10) {
                Xmomentum = ~Xmomentum | 1;
            }

            if (tile == 1 or tile == 9) {
                Ymomentum = ~Ymomentum | 1;
            }
            if (ballX <= (paddleX+8)) {
                if (ballX >= (paddleX - 8)) {
                    if (((ballY+5) >= 145)) {
                        if (((ballY+3) <= 145)) {
                            if (Ymomentum == 1) {
                                Ymomentum = 255;
                            }
                        }
                    }
                    if (((ballY) >= 145)) {
                        if (((ballY-3) <= 145)) {
                            if (Ymomentum == 255) {
                                Ymomentum = 1;
                            }
                        }
                    }
                }
            }
            frame = 1;
        } else {
            if (frame == 1) {
                if (left) {
                    if (paddleX > 16) {
                        paddleX = paddleX - 2;
                    }
                }
                if (right) {
                    if (paddleX < 104) {
                        paddleX = paddleX + 2;
                    }
                }

                display_oam_x[1] = ballX;
                display_oam_y[1] = ballY;
                display_oam_x[0] = paddleX;
                display_oam_y[0] = 145;
                frame = 0;
            }
        }
    }
}

main();