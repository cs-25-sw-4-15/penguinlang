procedure main() {
    control_LCDon();
    control_initDisplayRegs();
    control_initPalette();

    loop (1) {
        control_waitVBlankOver();
        control_waitVBlankStart();

        if (frame_count == 0) {
            control_updateInput();
            left = control_checkLeft();
            right = control_checkRight();
            if (Xmomentum == 1) {
                ballX = ballX + 2;
            } else {
                ballX = ballX - 2;
            }
            if (Ymomentum == 1) {
                ballY = ballY + 2;
            } else {
                ballY = ballY - 2;
            }

            Xtile = (ballX-9) >> 3;
            Ytile = (ballY-16) >> 3;
            tile = display_tilemap0[Xtile][Ytile];

            if (tile == BRICK_LEFT or tile == BRICK_RIGHT) {
                display_tilemap0[Xtile][Ytile] = BLANK_TILE;
                if (Ymomentum == 1) {
                    Ymomentum = 2;
                } else {
                    Ymomentum = 1;
                }
                if (tile == BRICK_LEFT) {
                    display_tilemap0[Xtile+1][Ytile] = BLANK_TILE;
                } else {
                    display_tilemap0[Xtile-1][Ytile] = BLANK_TILE;
                }
            }

            handleWallCollision();

            if (Ymomentum == 1) {
                if (((ballY+5) >= paddleY)) {
                    if (((ballY+3) <= paddleY)) {
                        if (ballX <= (paddleX+8)) {
                            if (ballX >= (paddleX - 8)) {
                                if (Ymomentum == 1) {
                                    Ymomentum = 2;
                                } else {
                                    Ymomentum = 1;
                                }
                            }
                        }
                    }
                }
            }
            if (Ymomentum == 2) {
                if (((ballY) >= paddleY)) {
                    if (((ballY-3) <= paddleY)) {
                        if (ballX <= (paddleX+8)) {
                            if (ballX >= (paddleX - 8)) {
                                if (Ymomentum == 1) {
                                    Ymomentum = 2;
                                } else {
                                    Ymomentum = 1;
                                }
                            }
                        }
                    }
                }
            }

            if (left) {
                if (paddleX > 16) {
                    paddleX = paddleX - 2;
                }
            }
            if (right) {
                if (paddleX < 104) {
                    paddleX = paddleX + 2;
                }
            }

            frame_count = 1;
        } else if (frame_count == 1) {
            display_oam_x[1] = ballX;
            display_oam_y[1] = ballY;
            display_oam_x[0] = paddleX;
            frame_count = 0;
        }
    }
}